#!/bin/bash
# claude-awake — run Claude Code and keep the Mac awake even with the lid closed.
#
# Usage:
#   claude-awake            start Claude Code (any extra args are passed to claude)
#   claude-awake --off      emergency reset: turn normal sleep back on
#   claude-awake --status   show whether lid-closed mode is on
#
# Sleep is restored automatically when:
#   - you quit Claude Code (or close the Terminal window), or
#   - you're on battery and it drops below MIN_BATTERY percent.

MIN_BATTERY=20   # percent; change this if you like

status() {
  if pmset -g | grep -q 'SleepDisabled[[:space:]]*1'; then
    echo "Lid-closed mode: ON (Mac will NOT sleep)"
  else
    echo "Lid-closed mode: OFF (normal sleep)"
  fi
}

case "$1" in
  --off)
    sudo pmset -a disablesleep 0 && echo "Normal sleep restored."
    exit ;;
  --status)
    status; exit ;;
esac

echo "claude-awake: your Mac password is needed once to turn off sleep."
sudo -v || { echo "Cancelled."; exit 1; }

# Guard process (runs as root): disables sleep, then restores it when
# Claude exits or the battery gets low.
sudo bash -c '
  WATCH_PID='"$$"'
  MIN='"$MIN_BATTERY"'
  restore() { pmset -a disablesleep 0; }
  trap restore EXIT
  pmset -a disablesleep 1
  while kill -0 "$WATCH_PID" 2>/dev/null; do
    batt=$(pmset -g batt)
    if echo "$batt" | grep -q "Battery Power"; then
      pct=$(echo "$batt" | grep -o "[0-9]*%" | head -1 | tr -d "%")
      if [ -n "$pct" ] && [ "$pct" -lt "$MIN" ]; then
        osascript -e "display notification \"Battery at ${pct}% - normal sleep restored\" with title \"claude-awake\"" 2>/dev/null
        exit
      fi
    fi
    sleep 30
  done
' >/dev/null 2>&1 &

sleep 1
status
echo "You can close the lid now. Plug in for long tasks, and don't put it in a bag."
echo

# Wait for the user to choose how to start Claude Code.
while true; do
  printf "Type 'claude' or 'c' to start Claude Code (q to quit): "
  read -r choice || choice=q
  case "$choice" in
    claude) claude "$@"; break ;;
    c)      claude --dangerously-skip-permissions "$@"; break ;;
    q|quit|exit) break ;;
    *) echo "Not recognised: '$choice'" ;;
  esac
done

echo
echo "Claude exited — restoring normal sleep..."
sleep 2
status
